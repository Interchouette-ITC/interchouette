# Static host URL rules (Render Static / Netlify-style).
# Specific rules first. On Render Dashboard → Redirects/Rewrites also set:
#   /* → /index.html (Rewrite) so Angular ** handles unknown paths.
# Real files (CV/*.pdf, img/*, etc.) are served as-is; rewrites skip existing assets.

# CV canonical without trailing slash
/CV/  /CV  301

# SPA fallback: unknown paths → Angular shell (client ** → home)
/*  /index.html  200
