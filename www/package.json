{
  "name": "interchouette",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/generate-news-static.mjs && ng build && node scripts/minify-static-html.mjs && node scripts/publish-clean-routes.mjs",
    "generate:news": "node scripts/generate-news-static.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run build && npm test && node scripts/verify-static-dist.mjs && node scripts/check-static-console.mjs",
    "minify:html": "node scripts/minify-static-html.mjs",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "console:static": "node scripts/check-static-console.mjs",
    "preflight": "bash ../.cursor/scripts/preflight-before-merge.sh"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-server": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/ssr": "^22.1.4",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@ngx-env/builder": "^22.0.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "html-minifier-terser": "^7.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
